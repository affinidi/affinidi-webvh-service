{
  "name": "webvh-ui",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir ../did-hosting-control/ui-dist",
    "typecheck": "tsc --noEmit",
    "gen:tasks": "trust-tasks-gen-ts --lock ../did-hosting-common/trust-tasks.lock --out lib/trust-tasks",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "expo": "^58.0.14",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@openvtc/trust-tasks": "^0.28.0",
    "@openvtc/trust-tasks-gen": "^0.1.1",
    "@types/react": "~19.3.0",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": ">=10.2.1",
    "postcss": ">=8.5.10",
    "@xmldom/xmldom": ">=0.8.13",
    "uuid": ">=11.1.1",
    "ws": ">=8.20.1",
    "shell-quote": ">=1.8.4",
    "@babel/core": "^7.29.6"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "private": true
}
