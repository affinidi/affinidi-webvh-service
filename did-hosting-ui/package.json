{
  "name": "did-hosting-ui",
  "version": "1.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --web",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir ../did-hosting-control/ui-dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:tasks": "trust-tasks-gen-ts --lock ../did-hosting-common/trust-tasks.lock --out lib/trust-tasks",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@expo-google-fonts/figtree": "^0.4.1",
    "@expo/metro-runtime": "~58.0.14",
    "expo": "^58.0.14",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@openvtc/trust-tasks": "^0.28.1",
    "@openvtc/trust-tasks-gen": "^0.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "postcss": "^8.5.10",
    "@xmldom/xmldom": "^0.9.12",
    "uuid": "^11.1.1",
    "ws": "^8.20.1",
    "shell-quote": "^1.8.4",
    "@babel/core": "^7.29.6",
    "glob": "^14.0.2",
    "eslint-config-expo": {
      "typescript": "~6.0.3"
    }
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "private": true
}
